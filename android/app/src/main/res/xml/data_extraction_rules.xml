<?xml version="1.0" encoding="utf-8"?>
<!-- The queue URL and bearer token live in SharedPreferences. Exclude them from
     cloud backup and device-to-device transfer so the credential that can drive
     this SIM never leaves the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
