<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks cleartext HTTP by default since API 28. Permit it ONLY for
     loopback, which is used with `adb reverse tcp:8000 tcp:8000` for local
     testing and never leaves the device. Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
